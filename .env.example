# Copy to .env.local and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Only for testing: shows a password login so you can sign in as demo clients
# (create them in Supabase → Authentication → Users → Add user, with "Auto Confirm").
# Leave out or set to false for the live version.
VITE_PASSWORD_LOGIN=true
